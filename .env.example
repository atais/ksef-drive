# Google OAuth Configuration
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# KSeF API proxy (production only — dev uses the Vite proxy in vite.config.ts).
# KSeF's API sends no CORS headers, so prod builds go through a small Cloudflare
# Worker that proxies to https://api.ksef.mf.gov.pl/v2. See worker/README.md.
VITE_KSEF_API_BASE=https://ksef-gdrive-proxy.<your-subdomain>.workers.dev

# Google Picker (archive folder chooser). API key from the same Cloud project
# with the Picker API enabled; app id is the project number.
VITE_GOOGLE_API_KEY=xxxxxxxxxxxxxxxxxxxxxx
VITE_GOOGLE_APP_ID=000000000000
